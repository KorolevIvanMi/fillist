<WarningForAdd>:
    
    canvas: 
        Color: 
            rgba: self.bg_color
        RoundedRectangle: 
            size: self.width, self.height
            pos: self.pos
            radius: [15,]
    Label:
        size_hint: 1,1
        text: root.label_text
        font_size: sp(20)
        font_name: "Guidy"
        color: root.ft_color
